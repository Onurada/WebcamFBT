<Window x:Class="WebcamFBT.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WebcamFBT" Width="1280" Height="840" MinWidth="1000" MinHeight="660"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" StateChanged="Window_StateChanged">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.65"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="ScaleCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
        <Style x:Key="ChipDot" TargetType="Ellipse">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Height" Value="9"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="{StaticResource IdleBrush}"/>
        </Style>
        <Style x:Key="ChipLabel" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.65"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ChipValue" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- Left: preview, status chips, log -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="8" Background="{StaticResource PreviewBackground}" ClipToBounds="True" Margin="0,0,0,12">
                <Grid>
                    <Image x:Name="Preview" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality"/>
                    <StackPanel x:Name="PlaceholderPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE714;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="48"
                                   HorizontalAlignment="Center" Opacity="0.5"/>
                        <TextBlock x:Name="PlaceholderText" Margin="0,14,0,0" FontSize="15" Opacity="0.75"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>
                    </StackPanel>
                    <Border x:Name="CalibOverlay" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="#D9101216" CornerRadius="12" Padding="34,22">
                        <StackPanel>
                            <TextBlock x:Name="CalibTitle" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="CalibSubtitle" FontSize="16" Margin="0,8,0,0" Opacity="0.8"
                                       HorizontalAlignment="Center" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <WrapPanel Grid.Row="1">
                <Border Style="{StaticResource Chip}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="EngineDot" Style="{StaticResource ChipDot}"/>
                        <TextBlock Text="{DynamicResource S.Chip.Engine}" Style="{StaticResource ChipLabel}"/>
                        <TextBlock x:Name="EngineValue" Style="{StaticResource ChipValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Chip}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="CameraDot" Style="{StaticResource ChipDot}"/>
                        <TextBlock Text="{DynamicResource S.Chip.Camera}" Style="{StaticResource ChipLabel}"/>
                        <TextBlock x:Name="CameraValue" Text="—" Style="{StaticResource ChipValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Chip}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ModelDot" Style="{StaticResource ChipDot}"/>
                        <TextBlock Text="{DynamicResource S.Chip.Model}" Style="{StaticResource ChipLabel}"/>
                        <TextBlock x:Name="ModelValue" Text="—" Style="{StaticResource ChipValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Chip}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="VrDot" Style="{StaticResource ChipDot}"/>
                        <TextBlock Text="{DynamicResource S.Chip.SteamVR}" Style="{StaticResource ChipLabel}"/>
                        <TextBlock x:Name="VrValue" Text="—" Style="{StaticResource ChipValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Chip}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="PersonDot" Style="{StaticResource ChipDot}"/>
                        <TextBlock Text="{DynamicResource S.Chip.Person}" Style="{StaticResource ChipLabel}"/>
                        <TextBlock x:Name="PersonValue" Text="—" Style="{StaticResource ChipValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Chip}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="CalibDot" Style="{StaticResource ChipDot}"/>
                        <TextBlock Text="{DynamicResource S.Chip.Calibration}" Style="{StaticResource ChipLabel}"/>
                        <TextBlock x:Name="CalibValue" Text="—" Style="{StaticResource ChipValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Chip}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="SentDot" Style="{StaticResource ChipDot}"/>
                        <TextBlock Text="{DynamicResource S.Chip.Trackers}" Style="{StaticResource ChipLabel}"/>
                        <TextBlock x:Name="SentValue" Text="—" Style="{StaticResource ChipValue}"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <TextBox x:Name="LogBox" Grid.Row="2" Height="120" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
        </Grid>

        <!-- Right: controls -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource S.Control.Title}" Style="{StaticResource SectionTitle}"/>
                        <Button x:Name="StartButton" Content="{DynamicResource S.Control.Start}" Height="44" FontSize="15"
                                HorizontalAlignment="Stretch" Style="{DynamicResource AccentButtonStyle}" Click="StartButton_Click"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="CalibrateButton" Content="{DynamicResource S.Control.Calibrate}" HorizontalAlignment="Stretch"
                                    IsEnabled="False" Click="CalibrateButton_Click"/>
                            <ToggleButton x:Name="PauseButton" Grid.Column="2" Content="{DynamicResource S.Control.Pause}" HorizontalAlignment="Stretch"
                                          IsEnabled="False" Click="PauseButton_Click"/>
                        </Grid>
                        <CheckBox x:Name="NoVrCheck" Content="{DynamicResource S.Control.NoVr}" Margin="0,10,0,0"/>
                        <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource S.Control.Hint}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource S.General.Title}" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource S.General.Language}" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="LanguageCombo" Grid.Column="1" HorizontalAlignment="Stretch"
                                      SelectionChanged="LanguageCombo_SelectionChanged"/>
                        </Grid>
                        <CheckBox x:Name="AutoStartCheck" Content="{DynamicResource S.General.AutoStart}" Margin="0,10,0,0" Click="AutoStartCheck_Click"/>
                        <CheckBox x:Name="RememberCalibCheck" Content="{DynamicResource S.General.RememberCalib}" Margin="0,6,0,0" Click="RememberCalibCheck_Click"/>
                        <CheckBox x:Name="ShowPreviewCheck" Content="{DynamicResource S.General.ShowPreview}" Margin="0,6,0,0" Click="ShowPreviewCheck_Click"/>
                        <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource S.General.Hint}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource S.Fine.Title}" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{DynamicResource S.Fine.Yaw}" Style="{StaticResource FieldLabel}"/>
                            <Button x:Name="YawLeftButton" Grid.Column="1" Content="◀ 2°" Width="72" Tag="-2" Click="YawButton_Click" IsEnabled="False"/>
                            <Button x:Name="YawRightButton" Grid.Column="3" Content="2° ▶" Width="72" Tag="2" Click="YawButton_Click" IsEnabled="False"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource S.Fine.Scale}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ScaleText" Margin="6,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button x:Name="ScaleDownButton" Grid.Row="2" Grid.Column="1" Content="−" Width="72" Tag="0.98" Click="ScaleButton_Click" IsEnabled="False"/>
                            <Button x:Name="ScaleUpButton" Grid.Row="2" Grid.Column="3" Content="+" Width="72" Tag="1.02" Click="ScaleButton_Click" IsEnabled="False"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource S.Fine.Hint}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource S.Trackers.Title}" Style="{StaticResource SectionTitle}"/>
                        <UniformGrid x:Name="TrackerGrid" Columns="2">
                            <CheckBox Content="{DynamicResource S.Trackers.Hip}" Tag="hip" Click="TrackerCheck_Click"/>
                            <CheckBox Content="{DynamicResource S.Trackers.Chest}" Tag="chest" Click="TrackerCheck_Click"/>
                            <CheckBox Content="{DynamicResource S.Trackers.LeftFoot}" Tag="left_foot" Click="TrackerCheck_Click"/>
                            <CheckBox Content="{DynamicResource S.Trackers.RightFoot}" Tag="right_foot" Click="TrackerCheck_Click"/>
                            <CheckBox Content="{DynamicResource S.Trackers.LeftKnee}" Tag="left_knee" Click="TrackerCheck_Click"/>
                            <CheckBox Content="{DynamicResource S.Trackers.RightKnee}" Tag="right_knee" Click="TrackerCheck_Click"/>
                            <CheckBox Content="{DynamicResource S.Trackers.LeftElbow}" Tag="left_elbow" Click="TrackerCheck_Click"/>
                            <CheckBox Content="{DynamicResource S.Trackers.RightElbow}" Tag="right_elbow" Click="TrackerCheck_Click"/>
                        </UniformGrid>
                        <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource S.Trackers.Hint}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource S.Camera.Title}" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{DynamicResource S.Camera.Label}" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CameraCombo" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="CameraCombo_SelectionChanged"/>
                            <Button x:Name="ScanButton" Grid.Column="3" Content="{DynamicResource S.Camera.Scan}" Click="ScanButton_Click"/>
                            <TextBlock Grid.Row="2" Text="{DynamicResource S.Camera.Model}" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="ModelCombo" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" HorizontalAlignment="Stretch"
                                      SelectionChanged="ModelCombo_SelectionChanged">
                                <ComboBoxItem Content="{DynamicResource S.Camera.ModelLite}" Tag="lite"/>
                                <ComboBoxItem Content="{DynamicResource S.Camera.ModelFull}" Tag="full"/>
                                <ComboBoxItem Content="{DynamicResource S.Camera.ModelHeavy}" Tag="heavy"/>
                            </ComboBox>
                        </Grid>
                        <CheckBox x:Name="MirrorCheck" Content="{DynamicResource S.Camera.Mirror}" Margin="0,10,0,0" Click="MirrorCheck_Click"/>
                        <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource S.Camera.Hint}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource S.Smooth.Title}" Style="{StaticResource SectionTitle}"/>

                        <TextBlock Text="{DynamicResource S.Smooth.Jitter}"/>
                        <Slider x:Name="SmoothSlider" Minimum="0.1" Maximum="3" IsDirectionReversed="True" Margin="0,4,0,0"
                                ValueChanged="SmoothSlider_ValueChanged"/>
                        <Grid Opacity="0.6" Margin="0,0,0,10">
                            <TextBlock Text="{DynamicResource S.Smooth.JitterLow}" Style="{StaticResource ScaleCaption}"/>
                            <TextBlock Text="{DynamicResource S.Smooth.JitterHigh}" Style="{StaticResource ScaleCaption}" HorizontalAlignment="Right"/>
                        </Grid>

                        <TextBlock Text="{DynamicResource S.Smooth.Beta}"/>
                        <Slider x:Name="BetaSlider" Minimum="0" Maximum="5" Margin="0,4,0,0" ValueChanged="BetaSlider_ValueChanged"/>
                        <Grid Opacity="0.6" Margin="0,0,0,10">
                            <TextBlock Text="{DynamicResource S.Smooth.BetaLow}" Style="{StaticResource ScaleCaption}"/>
                            <TextBlock Text="{DynamicResource S.Smooth.BetaHigh}" Style="{StaticResource ScaleCaption}" HorizontalAlignment="Right"/>
                        </Grid>

                        <TextBlock Text="{DynamicResource S.Smooth.Depth}"/>
                        <Slider x:Name="DepthSlider" Minimum="0" Maximum="1" Margin="0,4,0,0" ValueChanged="DepthSlider_ValueChanged"/>
                        <Grid Opacity="0.6" Margin="0,0,0,10">
                            <TextBlock Text="{DynamicResource S.Smooth.DepthLow}" Style="{StaticResource ScaleCaption}"/>
                            <TextBlock Text="{DynamicResource S.Smooth.DepthHigh}" Style="{StaticResource ScaleCaption}" HorizontalAlignment="Right"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource S.Smooth.Visibility}"/>
                            <TextBlock x:Name="VisibilityText" Margin="6,0,0,0" FontWeight="SemiBold"/>
                        </StackPanel>
                        <Slider x:Name="VisibilitySlider" Minimum="0.2" Maximum="0.9" Margin="0,4,0,0"
                                ValueChanged="VisibilitySlider_ValueChanged"/>

                        <CheckBox x:Name="FloorLockCheck" Content="{DynamicResource S.Smooth.FloorLock}" Margin="0,6,0,0" Click="FloorLockCheck_Click"/>
                        <CheckBox x:Name="FootLockCheck" Content="{DynamicResource S.Smooth.FootLock}" Margin="0,6,0,0" Click="FootLockCheck_Click"/>
                        <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource S.Smooth.Hint}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource S.Driver.Title}" Style="{StaticResource SectionTitle}"/>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DriverDot" Style="{StaticResource ChipDot}"/>
                            <TextBlock x:Name="DriverStatusText" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="InstallDriverButton" Content="{DynamicResource S.Driver.Install}" HorizontalAlignment="Stretch" Click="InstallDriverButton_Click"/>
                            <Button x:Name="UninstallDriverButton" Grid.Column="2" Content="{DynamicResource S.Driver.Uninstall}" HorizontalAlignment="Stretch" Click="UninstallDriverButton_Click"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource S.Driver.Hint}"/>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Hint}" Margin="4,0,0,8" Text="{DynamicResource S.Footer}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
