<Application x:Class="WebcamFBT.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="Dark">
    <Application.Resources>
        <SolidColorBrush x:Key="GoodBrush" Color="#3DDC97"/>
        <SolidColorBrush x:Key="WarnBrush" Color="#FFB547"/>
        <SolidColorBrush x:Key="BadBrush" Color="#FF5D6C"/>
        <SolidColorBrush x:Key="IdleBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="PreviewBackground" Color="#0C0D10"/>
    </Application.Resources>
</Application>
