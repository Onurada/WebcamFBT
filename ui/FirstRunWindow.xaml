<Window x:Class="WebcamFBT.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.Wizard.Title}" Width="640" Height="560" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Icon="Assets/app.ico">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="StepText" Opacity="0.6"/>
            <TextBlock x:Name="StepTitle" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- 1: welcome + language -->
                <StackPanel x:Name="Step1">
                    <TextBlock TextWrapping="Wrap" Text="{DynamicResource S.Wizard.WelcomeText}"/>
                    <TextBlock Text="{DynamicResource S.General.Language}" Margin="0,18,0,6"/>
                    <ComboBox x:Name="LanguageCombo" Width="220" HorizontalAlignment="Left" SelectionChanged="LanguageCombo_SelectionChanged"/>
                </StackPanel>

                <!-- 2: SteamVR driver -->
                <StackPanel x:Name="Step2" Visibility="Collapsed">
                    <TextBlock TextWrapping="Wrap" Text="{DynamicResource S.Wizard.DriverText}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Ellipse x:Name="DriverDot" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="DriverStatus" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button x:Name="InstallButton" Content="{DynamicResource S.Driver.Install}" Margin="0,12,0,0"
                            HorizontalAlignment="Left" MinWidth="180" Click="InstallButton_Click"/>
                    <TextBlock x:Name="DriverMessage" TextWrapping="Wrap" Margin="0,10,0,0" Opacity="0.8"/>
                </StackPanel>

                <!-- 3: camera -->
                <StackPanel x:Name="Step3" Visibility="Collapsed">
                    <TextBlock TextWrapping="Wrap" Text="{DynamicResource S.Wizard.CameraText}"/>
                    <ComboBox x:Name="CameraCombo" Margin="0,16,0,0" HorizontalAlignment="Stretch"/>
                    <Button x:Name="ScanButton" Content="{DynamicResource S.Camera.Scan}" Margin="0,10,0,0"
                            HorizontalAlignment="Left" MinWidth="120" Click="ScanButton_Click"/>
                    <TextBlock x:Name="CameraMessage" TextWrapping="Wrap" Margin="0,10,0,0" Opacity="0.8"/>
                </StackPanel>

                <!-- 4: placement -->
                <StackPanel x:Name="Step4" Visibility="Collapsed">
                    <TextBlock TextWrapping="Wrap" Text="{DynamicResource S.Wizard.PlacementText}"/>
                </StackPanel>

                <!-- 5: calibration and games -->
                <StackPanel x:Name="Step5" Visibility="Collapsed">
                    <TextBlock x:Name="CalibrationText" TextWrapping="Wrap"/>
                    <CheckBox x:Name="AutoStartCheck" Content="{DynamicResource S.General.AutoStart}" Margin="0,16,0,0"/>
                    <CheckBox x:Name="StartNowCheck" Content="{DynamicResource S.Wizard.StartNow}" Margin="0,6,0,0" IsChecked="True"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Button x:Name="SkipButton" Content="{DynamicResource S.Wizard.Skip}" HorizontalAlignment="Left" Click="SkipButton_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BackButton" Content="{DynamicResource S.Wizard.Back}" MinWidth="100" Margin="0,0,10,0" Click="BackButton_Click"/>
                <Button x:Name="NextButton" MinWidth="120" Style="{DynamicResource AccentButtonStyle}" Click="NextButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
