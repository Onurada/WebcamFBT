<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- English. To add a language, copy this file, translate it and add it to Loc.Languages. -->

    <!-- Status chips -->
    <sys:String x:Key="S.Chip.Engine">Engine</sys:String>
    <sys:String x:Key="S.Chip.Camera">Camera</sys:String>
    <sys:String x:Key="S.Chip.Model">Model</sys:String>
    <sys:String x:Key="S.Chip.SteamVR">SteamVR</sys:String>
    <sys:String x:Key="S.Chip.Person">Person</sys:String>
    <sys:String x:Key="S.Chip.Calibration">Calibration</sys:String>
    <sys:String x:Key="S.Chip.Trackers">Trackers</sys:String>

    <sys:String x:Key="S.Engine.Off">off</sys:String>
    <sys:String x:Key="S.Engine.Starting">starting</sys:String>
    <sys:String x:Key="S.Engine.Running">running</sys:String>
    <sys:String x:Key="S.Engine.Error">error</sys:String>
    <sys:String x:Key="S.Engine.NoResponse">not responding</sys:String>
    <sys:String x:Key="S.Camera.Fps">{0:0} FPS</sys:String>
    <sys:String x:Key="S.Camera.Lost">disconnected</sys:String>
    <sys:String x:Key="S.Model.Ms">{0:0} ms</sys:String>
    <sys:String x:Key="S.Vr.Connected">connected</sys:String>
    <sys:String x:Key="S.Vr.NoHmd">headset not tracked</sys:String>
    <sys:String x:Key="S.Vr.Waiting">waiting</sys:String>
    <sys:String x:Key="S.Vr.Off">off (test)</sys:String>
    <sys:String x:Key="S.Person.Yes">visible</sys:String>
    <sys:String x:Key="S.Person.No">none</sys:String>
    <sys:String x:Key="S.Calib.Running">in progress…</sys:String>
    <sys:String x:Key="S.Calib.Ready">ready</sys:String>
    <sys:String x:Key="S.Calib.ReadySaved">ready (saved)</sys:String>
    <sys:String x:Key="S.Calib.None">none ({0})</sys:String>
    <sys:String x:Key="S.Sent.Paused">paused</sys:String>
    <sys:String x:Key="S.Sent.Count">{0} sending</sys:String>
    <sys:String x:Key="S.Sent.None">not sending</sys:String>

    <!-- Preview -->
    <sys:String x:Key="S.Placeholder.Off">Engine is off. Press Start on the right to begin.</sys:String>
    <sys:String x:Key="S.Placeholder.Starting">Starting the engine… (about 5–10 s)</sys:String>
    <sys:String x:Key="S.Placeholder.Camera">Opening the camera…</sys:String>
    <sys:String x:Key="S.Placeholder.Crashed">The engine stopped unexpectedly (code {0}). See the log below for details.</sys:String>
    <sys:String x:Key="S.Placeholder.PreviewOff">Preview is off. Tracking keeps running in the background.</sys:String>
    <sys:String x:Key="S.Overlay.Countdown">Stand straight, look ahead</sys:String>
    <sys:String x:Key="S.Overlay.Collect">Hold still…</sys:String>
    <sys:String x:Key="S.Overlay.CollectSub">Measuring</sys:String>
    <sys:String x:Key="S.Overlay.OkTitle">Calibration done ✓</sys:String>
    <sys:String x:Key="S.Overlay.OkSub">Now run the full body calibration in your game</sys:String>
    <sys:String x:Key="S.Overlay.FailTitle">Calibration failed</sys:String>
    <sys:String x:Key="S.Overlay.FailSub">Wear the headset and make sure your whole body is visible, head to toe</sys:String>

    <!-- General -->
    <sys:String x:Key="S.General.Title">General</sys:String>
    <sys:String x:Key="S.General.Language">Language</sys:String>
    <sys:String x:Key="S.General.AutoStart">Start the engine when the app opens</sys:String>
    <sys:String x:Key="S.General.RememberCalib">Remember calibration (while the camera stays put)</sys:String>
    <sys:String x:Key="S.General.ShowPreview">Show camera preview</sys:String>
    <sys:String x:Key="S.General.Hint">The preview pauses by itself while the window is minimized, leaving the CPU to your game.</sys:String>

    <!-- Control -->
    <sys:String x:Key="S.Control.Title">Control</sys:String>
    <sys:String x:Key="S.Control.Start">▶  Start</sys:String>
    <sys:String x:Key="S.Control.Stop">■  Stop</sys:String>
    <sys:String x:Key="S.Control.Calibrate">Calibrate ({0})</sys:String>
    <sys:String x:Key="S.Control.Pause">Pause ({0})</sys:String>
    <sys:String x:Key="S.Control.NoVr">Test without SteamVR (preview only)</sys:String>
    <sys:String x:Key="S.Control.Hint">Calibration: wear the headset, stand straight in front of the camera and look ahead. After the first beep wait 3 s, at the second beep hold still for 2 s.</sys:String>

    <!-- Fine tuning -->
    <sys:String x:Key="S.Fine.Title">Fine tuning</sys:String>
    <sys:String x:Key="S.Fine.Yaw">Camera direction</sys:String>
    <sys:String x:Key="S.Fine.Scale">Scale</sys:String>
    <sys:String x:Key="S.Fine.Hint">Use these if your legs end up sideways or the height is off after calibrating.</sys:String>

    <!-- Trackers -->
    <sys:String x:Key="S.Trackers.Title">Trackers</sys:String>
    <sys:String x:Key="S.Trackers.Hip">Hip</sys:String>
    <sys:String x:Key="S.Trackers.Chest">Chest</sys:String>
    <sys:String x:Key="S.Trackers.LeftFoot">Left foot</sys:String>
    <sys:String x:Key="S.Trackers.RightFoot">Right foot</sys:String>
    <sys:String x:Key="S.Trackers.LeftKnee">Left knee</sys:String>
    <sys:String x:Key="S.Trackers.RightKnee">Right knee</sys:String>
    <sys:String x:Key="S.Trackers.LeftElbow">Left elbow</sys:String>
    <sys:String x:Key="S.Trackers.RightElbow">Right elbow</sys:String>
    <sys:String x:Key="S.Trackers.Hint">Hip + both feet are the most solid. Elbows, knees and chest are noisier.</sys:String>

    <!-- Camera and model -->
    <sys:String x:Key="S.Camera.Title">Camera and model</sys:String>
    <sys:String x:Key="S.Camera.Label">Camera</sys:String>
    <sys:String x:Key="S.Camera.Scan">Scan</sys:String>
    <sys:String x:Key="S.Camera.Scanning">Scanning…</sys:String>
    <sys:String x:Key="S.Camera.Item">Camera {0}  ({1}×{2})</sys:String>
    <sys:String x:Key="S.Camera.ItemSimple">Camera {0}</sys:String>
    <sys:String x:Key="S.Camera.NotFound">Camera {0} (not found)</sys:String>
    <sys:String x:Key="S.Camera.Model">Model</sys:String>
    <sys:String x:Key="S.Camera.ModelLite">Fast (lite)</sys:String>
    <sys:String x:Key="S.Camera.ModelFull">Balanced (full)</sys:String>
    <sys:String x:Key="S.Camera.ModelHeavy">Accurate, slow (heavy)</sys:String>
    <sys:String x:Key="S.Camera.Mirror">Mirror the preview</sys:String>
    <sys:String x:Key="S.Camera.Hint">Changing the camera or model restarts the engine. Scanning needs the engine to be off. Good lighting raises the camera's frame rate.</sys:String>

    <!-- Smoothing -->
    <sys:String x:Key="S.Smooth.Title">Smoothing</sys:String>
    <sys:String x:Key="S.Smooth.Jitter">Jitter reduction</sys:String>
    <sys:String x:Key="S.Smooth.JitterLow">fast response</sys:String>
    <sys:String x:Key="S.Smooth.JitterHigh">smoother</sys:String>
    <sys:String x:Key="S.Smooth.Beta">Lag reduction on fast moves</sys:String>
    <sys:String x:Key="S.Smooth.BetaLow">less</sys:String>
    <sys:String x:Key="S.Smooth.BetaHigh">more</sys:String>
    <sys:String x:Key="S.Smooth.Depth">Depth smoothing (towards/away from the camera)</sys:String>
    <sys:String x:Key="S.Smooth.DepthLow">off</sys:String>
    <sys:String x:Key="S.Smooth.DepthHigh">strong</sys:String>
    <sys:String x:Key="S.Smooth.Visibility">Visibility threshold</sys:String>
    <sys:String x:Key="S.Smooth.FloorLock">Keep feet above the floor</sys:String>
    <sys:String x:Key="S.Smooth.FootLock">Pin planted feet (stops sliding)</sys:String>
    <sys:String x:Key="S.Smooth.Hint">Joints below the visibility threshold hold their last position; barely visible joints are smoothed harder.</sys:String>

    <!-- Driver -->
    <sys:String x:Key="S.Driver.Title">SteamVR driver</sys:String>
    <sys:String x:Key="S.Driver.Install">Install / repair</sys:String>
    <sys:String x:Key="S.Driver.Uninstall">Remove</sys:String>
    <sys:String x:Key="S.Driver.Hint">Install and remove while SteamVR is closed.</sys:String>
    <sys:String x:Key="S.Driver.Installed">Installed</sys:String>
    <sys:String x:Key="S.Driver.NotInstalled">Not installed</sys:String>
    <sys:String x:Key="S.Driver.CloseSteamVr">Close SteamVR first, then try again.</sys:String>
    <sys:String x:Key="S.Driver.ConfirmUninstall">Remove the WebcamFBT driver from SteamVR?</sys:String>
    <sys:String x:Key="S.Driver.InstallDone">Driver installed and tracker roles assigned.</sys:String>
    <sys:String x:Key="S.Driver.UninstallDone">Driver removed.</sys:String>
    <sys:String x:Key="S.Driver.Failed">Driver operation failed: {0}</sys:String>

    <sys:String x:Key="S.Footer">{0} = calibrate, {1} = pause. These hotkeys also work while you are in a game (the game does not get those keys).</sys:String>

    <!-- Log -->
    <sys:String x:Key="S.Log.Folder">Folder: {0}</sys:String>
    <sys:String x:Key="S.Log.RootMissing">WebcamFBT folder not found. Run this program from inside the WebcamFBT folder.</sys:String>
    <sys:String x:Key="S.Log.PythonMissing">Python environment not found: {0}</sys:String>
    <sys:String x:Key="S.Log.ConfigError">Could not read the settings file: {0}</sys:String>
    <sys:String x:Key="S.Log.SaveError">Could not save settings: {0}</sys:String>
    <sys:String x:Key="S.Log.StartError">Could not start the engine: {0}</sys:String>
    <sys:String x:Key="S.Log.Restarting">{0}, restarting the engine…</sys:String>
    <sys:String x:Key="S.Log.CameraChanged">Camera changed</sys:String>
    <sys:String x:Key="S.Log.ModelChanged">Model changed</sys:String>
    <sys:String x:Key="S.Log.NoVrWarning">Warning: SteamVR is not connected, calibration needs the headset.</sys:String>
    <sys:String x:Key="S.Log.ScanStart">Scanning cameras (this can take a few seconds)…</sys:String>
    <sys:String x:Key="S.Log.ScanDone">Found {0} camera(s).</sys:String>
    <sys:String x:Key="S.Log.ScanFailed">Scan failed: {0}</sys:String>
    <sys:String x:Key="S.Log.Error">ERROR: {0}</sys:String>
    <sys:String x:Key="S.Log.AutoRestart">The engine stopped unexpectedly (code {0}), restarting ({1}/{2})…</sys:String>
    <sys:String x:Key="S.Log.AutoRestartGaveUp">The engine stopped {0} times in a short time, automatic restart gave up. Details are in the logs folder.</sys:String>
    <sys:String x:Key="S.Log.Hung">The engine has not responded for {0} seconds, restarting it…</sys:String>
    <sys:String x:Key="S.Log.ConfigBroken">The settings file was broken; it was kept as {0} and defaults are used.</sys:String>

    <!-- Reliability -->
    <sys:String x:Key="S.Engine.Restarting">restarting</sys:String>
    <sys:String x:Key="S.Placeholder.Restarting">The engine stopped, restarting…</sys:String>
    <sys:String x:Key="S.Camera.NoFrames">no image</sys:String>
    <sys:String x:Key="S.Vr.DriverMissing">driver gets no data</sys:String>
    <sys:String x:Key="S.Vr.PortBusy">port in use</sys:String>
    <sys:String x:Key="S.Vr.DriverOutdated">old driver (restart SteamVR)</sys:String>
    <sys:String x:Key="S.Overlay.RecenterTitle">Tracking space changed</sys:String>
    <sys:String x:Key="S.Overlay.RecenterFixed">Calibration was corrected automatically. Press {0} if anything looks off.</sys:String>
    <sys:String x:Key="S.Overlay.RecenterMaybe">If the trackers look off, recalibrate with {0}.</sys:String>
    <sys:String x:Key="S.Calib.Check">check ({0})</sys:String>
    <sys:String x:Key="S.General.OpenLogs">Open log folder</sys:String>
    <sys:String x:Key="S.General.HotkeyCalibrate">Calibrate hotkey</sys:String>
    <sys:String x:Key="S.General.HotkeyPause">Pause hotkey</sys:String>
    <sys:String x:Key="S.Log.HotkeysChanged">Hotkeys changed</sys:String>
    <sys:String x:Key="S.Log.HotkeyDuplicate">Two actions cannot share the same key.</sys:String>
</ResourceDictionary>
