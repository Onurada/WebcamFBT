<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the notification area icon (NotifyIcon); the UI itself is WPF -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>WebcamFBT</AssemblyName>
    <Product>WebcamFBT</Product>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Fluent ThemeMode is still marked experimental -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep WPF names (Button, MessageBox, Application...) unambiguous -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
